{
  "name": "pwa-kit-modern",
  "version": "2.0.0",
  "description": "Modern Progressive Web App starter kit with advanced features",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "pwa:generate-icons": "pwa-asset-generator icon.svg public/img --manifest public/manifest.webmanifest",
    "lighthouse": "lighthouse http://localhost:5173 --output=html --output-path=./lighthouse-report.html --chrome-flags='--headless'",
    "analyze": "npx vite-bundle-analyzer dist/stats.html",
    "sw:precache": "workbox generateSW workbox-config.js",
    "deploy": "npm run build && npm run sw:precache",
    "serve:https": "serve -s dist -p 3000 --ssl-cert cert.pem --ssl-key key.pem"
  },
  "dependencies": {
    "workbox-window": "^7.0.0",
    "idb": "^8.0.0",
    "comlink": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "lighthouse": "^11.4.0",
    "playwright": "^1.40.0",
    "prettier": "^3.1.1",
    "pwa-asset-generator": "^6.3.1",
    "serve": "^14.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.0.4",
    "workbox-cli": "^7.0.0"
  },
  "keywords": [
    "pwa",
    "progressive-web-app",
    "service-worker",
    "workbox",
    "typescript",
    "vite",
    "modern-web"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/pwa-kit-modern.git"
  },
  "bugs": {
    "url": "https://github.com/username/pwa-kit-modern/issues"
  },
  "homepage": "https://github.com/username/pwa-kit-modern#readme",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}