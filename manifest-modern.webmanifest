{
  "name": "Progressive Web App Kit",
  "short_name": "PWA Kit",
  "description": "Modern PWA starter with advanced features and perfect Lighthouse scores",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#1976d2",
  "background_color": "#ffffff",
  "lang": "en-US",
  "dir": "ltr",
  
  "icons": [
    {
      "src": "/img/icons-72.png",
      "type": "image/png",
      "sizes": "72x72"
    },
    {
      "src": "/img/icons-96.png",
      "type": "image/png", 
      "sizes": "96x96"
    },
    {
      "src": "/img/icons-128.png",
      "type": "image/png",
      "sizes": "128x128"
    },
    {
      "src": "/img/icons-144.png",
      "type": "image/png",
      "sizes": "144x144"
    },
    {
      "src": "/img/icons-152.png",
      "type": "image/png",
      "sizes": "152x152"
    },
    {
      "src": "/img/icons-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/img/icons-384.png",
      "type": "image/png",
      "sizes": "384x384"
    },
    {
      "src": "/img/icons-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/img/icons-512-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "/img/screenshot-narrow.png",
      "type": "image/png",
      "sizes": "640x1136",
      "form_factor": "narrow"
    },
    {
      "src": "/img/screenshot-wide.png", 
      "type": "image/png",
      "sizes": "1280x720",
      "form_factor": "wide"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Connectivity Check",
      "short_name": "Check Status",
      "description": "Quick connectivity status check",
      "url": "/check",
      "icons": [
        {
          "src": "/img/check-icon.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "categories": ["utilities", "productivity"],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "file_handlers": [
    {
      "action": "/handle-file",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+pwa",
      "url": "/handle?url=%s"
    }
  ]
}